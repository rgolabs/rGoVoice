# Copy to .env (optional). Keys can also be entered in the UI (stored in data/settings.json).
ELEVENLABS_API_KEY=
# Force the local engine's device: cpu | mps | cuda (default: auto, MPS on Apple Silicon)
# RGOVOICE_DEVICE=cpu
# Where XTTS weights live (default: ./data/models). Point at a bigger disk if needed.
# TTS_HOME=/Volumes/Big/tts-models
# PORT=8765
